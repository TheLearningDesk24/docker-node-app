# MULTI-STAGE EXAMPLE
# This app is plain JavaScript and has no compile/build step. The stages below
# demonstrate the pattern, but do not provide a major size benefit by themselves.
# For TypeScript, bundlers, or generated assets, the build stage would do real work.

FROM node:22-alpine AS base
WORKDIR /app
COPY package*.json ./

FROM base AS build
# There are no third-party dependencies in this starter.
# If you later add dependencies, run npm ci here to install them.
COPY src/ ./src/

FROM node:22-alpine AS runtime
ENV NODE_ENV=production
ENV PORT=3000
WORKDIR /app

# Copy only the runtime files from the build stage.
COPY --from=build --chown=node:node /app/package.json ./package.json
COPY --from=build --chown=node:node /app/src ./src

USER node
EXPOSE 3000
CMD ["node", "src/server.js"]
